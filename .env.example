# ---------------------------------------------------------------------------
# Copie este archivo a .env y rellene sus credenciales.
# El archivo .env NUNCA se sube a git (está en .gitignore).
# ---------------------------------------------------------------------------

# --- Fuente de datos on-chain: bitcoin-data.com (BGeometrics) --------------
# Registro gratuito en https://bitcoin-data.com  ->  portal -> API key
# Sin key funciona igual, pero con un cupo mucho menor (10 req/hora, 15/día).
BITCOIN_DATA_API_KEY=

# Cupo de su plan. Ajústelos si sube de plan; el sistema los respeta y nunca
# los excede. Free: 10/hora, 15/día. Advanced: 200/hora, 300/día.
BITCOIN_DATA_REQ_PER_HOUR=10
BITCOIN_DATA_REQ_PER_DAY=15

# --- Alertas por Telegram ---------------------------------------------------
# 1. Hable con @BotFather en Telegram -> /newbot -> copie el token
# 2. Hable con @userinfobot -> copie su ID numérico
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Servidor local ---------------------------------------------------------
HOST=127.0.0.1
PORT=8848
